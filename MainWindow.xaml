<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Yorii_Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Yorii_Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Yorii Launcher"
    Closed="Window_Closed"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Image
            x:Name="backgroundImage"
            Grid.RowSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stretch="UniformToFill"
            Visibility="Collapsed" />
        <Grid
            x:Name="overlayGrid"
            Grid.RowSpan="3"
            Opacity="0" />

        <TitleBar
            x:Name="titleBar"
            Title="Yorii Launcher"
            Grid.Row="0"
            VerticalAlignment="Top"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="False"
            Subtitle="Preview">

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Tiles/GalleryIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        x:Name="BugReportButton"
                        Width="32"
                        Height="32"
                        Padding="0,0,0,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="BugReportButton_Click"
                        ToolTipService.ToolTip="Report Bug">
                        <FontIcon
                            FontSize="16"
                            FontWeight="Light"
                            Glyph="&#xEBE8;" />
                    </Button>
                    <Button
                        x:Name="OpenFolderButton"
                        Width="32"
                        Height="32"
                        Padding="0,0,0,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="OpenFolderButton_Click"
                        ToolTipService.ToolTip="Open Minecraft Directory">
                        <FontIcon
                            Margin="0,0,0,0"
                            FontSize="16"
                            FontWeight="Light"
                            Glyph="&#xE838;" />
                    </Button>
                    <Button
                        x:Name="NotesButton"
                        Width="36"
                        Height="36"
                        Padding="0,0,0,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="NotesButton_Click">
                        <FontIcon
                            FontSize="16"
                            FontWeight="Light"
                            Glyph="&#xE789;" />
                    </Button>
                    <Button
                        x:Name="ModsButton"
                        Width="32"
                        Height="32"
                        Padding="0,0,0,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="ModsButton_Click"
                        ToolTipService.ToolTip="Manage Mods">
                        <FontIcon
                            FontSize="16"
                            FontWeight="Light"
                            Glyph="&#xEA86;" />
                    </Button>
                    <Button
                        x:Name="settingsButton"
                        Width="32"
                        Height="32"
                        Padding="0,0,0,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon
                            Margin="0,0,0,0"
                            FontSize="16"
                            FontWeight="Light"
                            Glyph="&#xE713;" />
                    </Button>


                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
        <Frame x:Name="mainFrame" Grid.Row="1" />
        <StackPanel Grid.Row="2" Visibility="Visible">
            <ProgressBar
                x:Name="downloadProgressBar"
                Height="8"
                Maximum="100"
                Minimum="0"
                Opacity="0" />
            <Border
                Height="86"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">

                        <ComboBox
                            x:Name="accountComboBox"
                            Grid.Column="0"
                            Width="250"
                            Height="36"
                            Margin="36,0,0,0"
                            HorizontalAlignment="Left"
                            PlaceholderText="Player"
                            SelectionChanged="AccountComboBox_SelectionChanged"
                            Style="{StaticResource AcrylicComboBoxStyle}" />

                    </StackPanel>
                    <Button
                        x:Name="playButton"
                        Grid.Column="1"
                        Width="188"
                        Height="36"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Click="PlayButton_Click"
                        Content="Play"
                        Style="{ThemeResource AccentButtonStyle}" />

                    <ComboBox
                        x:Name="versionComboBox"
                        Grid.Column="2"
                        Width="250"
                        Height="36"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Right"
                        DropDownClosed="VersionList_DropDownClosed"
                        SelectionChanged="VersionList_SelectionChanged"
                        Style="{StaticResource AcrylicComboBoxStyle}" />

                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
