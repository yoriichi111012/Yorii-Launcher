<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Yorii_Launcher.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Yorii_Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="ModsNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="240"
        PaneDisplayMode="Left"
        SelectionChanged="ModsNavigation_SelectionChanged">

        <NavigationView.MenuItems>

            <NavigationViewItem Content="Installed Mods" Tag="installed">

                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>

            </NavigationViewItem>

            <NavigationViewItem Content="Download Mods" Tag="download">

                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Download" />
                </NavigationViewItem.Icon>

            </NavigationViewItem>

        </NavigationView.MenuItems>

        <Frame x:Name="ModsFrame" />

    </NavigationView>

</Page>
