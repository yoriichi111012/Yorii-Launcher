  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
	<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

	<PropertyGroup>
	<PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
	<PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
	<PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
	<PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
	<TrimMode>partial</TrimMode>
	<InvariantGlobalization>true</InvariantGlobalization>
	<!-- keep trim + AOT diagnostics on for every build (not just publish) so
	     NativeAOT-incompatible code can never slip back in silently -->
	<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	<EnableAotAnalyzer>true</EnableAotAnalyzer>
	<!-- CsWinRT projection diagnostics at max: types crossing the WinRT ABI
	     (ItemsSource collections, container items) need generated vtables;
	     level 2 also covers built-in mapped interfaces -->
	<CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
	<!-- IL2104 ("assembly X produced trim warnings") and IL3053 (same for AOT
	     analysis) are unactionable: they fire for third-party/framework
	     assemblies (HtmlAgilityPack, WinRT, the WinForms broker assemblies
	     kept for login, YamlDotNet internals — only its static builders are
	     used). WMC1510 (XAML binding trim warnings) fires for the remaining
	     {Binding TemplatedParent} sites in Resources/SettingsExpander.xaml and
	     Resources/ComboBox.xaml: their sources are the EXTERNAL toolkit
	     SettingsExpander/SettingsCard (fully rooted in Helpers/linker.xml)
	     and the framework ComboBox (OS projection, never trimmed), so all are
	     runtime-safe; the OneWay convertible sites already use TemplateBinding.
	     our own trim/AOT issues still surface as IL2026/IL3050/etc. -->
	<NoWarn>$(NoWarn);IL2104;IL3053;WMC1510</NoWarn>
	</PropertyGroup>

	<!-- runtime + layout efficiency: jit profile-guided opts, drop XBF line
	     info in release (smaller xbf, faster load, less xaml memory) -->
	<PropertyGroup>
		<TieredPGO>true</TieredPGO>
		<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
		<EnableXbfLineInfo Condition="'$(Configuration)' != 'Debug'">false</EnableXbfLineInfo>
	</PropertyGroup>

