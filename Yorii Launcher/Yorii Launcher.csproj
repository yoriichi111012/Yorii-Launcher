  <!-- unneeded WinAppSDK metapackage payloads (~45MB): AI/ML ships
       onnxruntime+DirectML, Search/Widgets are unused by this app.
       patterns resolved inside the target because packages re-copy them
       during Build -->
	<ItemGroup>
	  <!-- XboxAuthNet (via CmlLib.Core.Auth.Microsoft) declares a WinForms
	       framework reference for its interactive broker, which copies
	       ~27MB of System.Windows.Forms into self-contained output even
	       though this app never uses it (login is custom WebView2) -->
	  <FrameworkReference Remove="Microsoft.WindowsDesktop.App.WindowsForms" />
	</ItemGroup>

  <!-- strips junk from BOTH the build output dir and the publish layout
       (dotnet publish stages payloads under win-x64\publish, which the
       Build-anchored pass never saw) -->
  <Target Name="StripUnusedWinAppSdkPayloads" AfterTargets="Build;Publish" BeforeTargets="Pack">
    <PropertyGroup>
      <_BinAbs>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutDir)'))</_BinAbs>
      <_PubAbs>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutDir)publish\'))</_PubAbs>
    </PropertyGroup>
    <ItemGroup>
      <_WinAppSdkJunk Include="$(_BinAbs)onnxruntime*.dll;&#xD;&#xA;                               $(_BinAbs)DirectML.dll;&#xD;&#xA;                               $(_BinAbs)microsoft.windows.search.*;&#xD;&#xA;                               $(_BinAbs)microsoft.windows.widgets.*;&#xD;&#xA;                               $(_BinAbs)Microsoft.Windows.Search.dll;&#xD;&#xA;                               $(_BinAbs)Microsoft.Windows.Widgets.dll;&#xD;&#xA;                               $(_BinAbs)Microsoft.Windows.Search.Projection.dll;&#xD;&#xA;                               $(_BinAbs)Microsoft.Windows.Widgets.Projection.dll;&#xD;&#xA;                               $(_BinAbs)Microsoft.Windows.Search.winmd;&#xD;&#xA;                               $(_BinAbs)Microsoft.Windows.Widgets.winmd;&#xD;&#xA;                               $(_BinAbs)System.Windows.Forms.dll;&#xD;&#xA;                               $(_BinAbs)System.Windows.Forms.Design.dll;&#xD;&#xA;                               $(_BinAbs)System.Windows.Forms.Design.Editors.dll;&#xD;&#xA;                               $(_BinAbs)System.Windows.Forms.Primitives.dll;&#xD;&#xA;                               $(_PubAbs)onnxruntime*.dll;&#xD;&#xA;                               $(_PubAbs)DirectML.dll;&#xD;&#xA;                               $(_PubAbs)microsoft.windows.search.*;&#xD;&#xA;                               $(_PubAbs)microsoft.windows.widgets.*;&#xD;&#xA;                               $(_PubAbs)Microsoft.Windows.Search.dll;&#xD;&#xA;                               $(_PubAbs)Microsoft.Windows.Widgets.dll;&#xD;&#xA;                               $(_PubAbs)Microsoft.Windows.Search.Projection.dll;&#xD;&#xA;                               $(_PubAbs)Microsoft.Windows.Widgets.Projection.dll;&#xD;&#xA;                               $(_PubAbs)Microsoft.Windows.Search.winmd;&#xD;&#xA;                               $(_PubAbs)Microsoft.Windows.Widgets.winmd;&#xD;&#xA;                               $(_PubAbs)System.Windows.Forms.dll;&#xD;&#xA;                               $(_PubAbs)System.Windows.Forms.Design.dll;&#xD;&#xA;                               $(_PubAbs)System.Windows.Forms.Design.Editors.dll;&#xD;&#xA;                               $(_PubAbs)System.Windows.Forms.Primitives.dll" />
      <_FormsSatellites Include="$(_BinAbs)cs\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)de\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)es\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)fr\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)it\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)ja\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)ko\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)pl\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)pt-BR\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)ru\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)tr\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)zh-Hans\System.Windows.Forms.*;&#xD;&#xA;                                $(_BinAbs)zh-Hant\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)cs\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)de\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)es\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)fr\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)it\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)ja\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)ko\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)pl\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)pt-BR\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)ru\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)tr\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)zh-Hans\System.Windows.Forms.*;&#xD;&#xA;                                $(_PubAbs)zh-Hant\System.Windows.Forms.*" />
     </ItemGroup>
    <Delete Files="@(_WinAppSdkJunk);@(_FormsSatellites)" />
    <!-- strip 100+ language satellite assemblies that ship with the self-contained runtime and winappsdk, keep only en + en-US -->
    <ItemGroup>
      <_LangResourcesBin Include="$(_BinAbs)**\*.resources.dll" Exclude="$(_BinAbs)en\**; $(_BinAbs)en-US\**" />
      <_LangResourcesPub Include="$(_PubAbs)**\*.resources.dll" Exclude="$(_PubAbs)en\**; $(_PubAbs)en-US\**" />
      <_BgBin Include="$(_BinAbs)Resources\launcherbackground.png" />
      <_BgPub Include="$(_PubAbs)Resources\launcherbackground.png" />
    </ItemGroup>
    <Delete Files="@(_LangResourcesBin); @(_LangResourcesPub); @(_BgBin); @(_BgPub)" />
  </Target>
  <!-- NativeAOT publish does not copy compiled XAML (.xbf) to the publish
       dir (upstream WindowsAppSDK#6394): without them every launch dies in
       InitializeComponent with 'Cannot locate resource from
       ms-appx:///MainWindow.xaml'. resources.pri already arrives intact;
       only the .xbf tree needs backfilling, preserving subfolders. -->
  <Target Name="CopyXamlResourcesForAot" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <_AotXbf Include="$(OutputPath)**\*.xbf" Exclude="$(PublishDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_AotXbf)" DestinationFiles="@(_AotXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <PRIResource Remove="%2a%2a\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="%2a%2a/%2a.resx" />
  </ItemGroup>
  <ItemGroup>
    <PRIResource Remove="%2a%2a/%2a.resw" />
  </ItemGroup>
  <!-- single-project MSIX stages the AppX dir incrementally: when a packaging
       run is interrupted (app still running locks files, build stopped), the
       dir is left partial and later incremental builds consider outputs up to
       date, so missing .xbf files are never re-staged. heal that automatically
       by wiping the stale staging dir BEFORE build, so this same build
       re-stages it fully. scoped to VS builds only: plain dotnet build never
       stages AppX and must not touch it -->
  <Target Name="HealStaleAppxXamlPayload" BeforeTargets="Build" Condition="'$(BuildingInsideVisualStudio)' == 'true' And Exists('$(OutDir)AppX\AppxManifest.xml')">
    <ItemGroup>
      <_AppxExpectedXbfHeal Include="@(Page->'$(OutDir)AppX\%(RelativeDir)%(Filename).xbf')" Condition="'%(Page.Extension)' == '.xaml'" />
      <_AppxMissingXbfHeal Include="@(_AppxExpectedXbfHeal)" Condition="!Exists('%(_AppxExpectedXbfHeal.Identity)')" />
      <_OutExpectedXbfHeal Include="@(Page->'$(OutDir)%(RelativeDir)%(Filename).xbf')" Condition="'%(Page.Extension)' == '.xaml'" />
      <_OutMissingXbfHeal Include="@(_OutExpectedXbfHeal)" Condition="!Exists('%(_OutExpectedXbfHeal.Identity)')" />
    </ItemGroup>
    <Warning Condition="'@(_AppxMissingXbfHeal)' != ''" Text="Stale AppX staging detected (%(_AppxMissingXbfHeal.Filename).xbf missing) - wiping $(OutDir)AppX so this build re-stages it. Close any running Yorii Launcher first." />
    <RemoveDir Directories="$(OutDir)AppX" Condition="'@(_AppxMissingXbfHeal)' != ''" />
    <!-- deeper staleness: the build-output .xbf itself is gone while obj claims
         up to date - touch the pages to force XAML recompile in this build -->
    <Touch Files="@(Page)" Condition="'@(_OutMissingXbfHeal)' != ''" />
  </Target>
  <!-- backstop for the healer above: if the layout is STILL broken after this
       build re-staged it, fail loudly instead of shipping a package that can
       never launch (missing MainWindow.xbf dies in InitializeComponent with
       XamlParseException 'Cannot locate resource from
       ms-appx:///MainWindow.xaml'; a partially stale layout crashes only when
       navigating to the affected page). scoped to VS builds only: plain
       dotnet build never stages AppX and must not trip on its absence -->
  <Target Name="VerifyAppxXamlPayload" AfterTargets="Build" Condition="'$(BuildingInsideVisualStudio)' == 'true' And Exists('$(OutDir)AppX\AppxManifest.xml')">
    <Error Condition="!Exists('$(OutDir)AppX\MainWindow.xbf')" Text="AppX layout at $(OutDir)AppX is missing MainWindow.xbf (stale incremental packaging). Close all Yorii Launcher processes, delete bin/obj/.vs, then Rebuild." />
    <!-- sweep every compiled page: a missing page .xbf crashes on navigation
         to that page exactly like the MainWindow case above -->
    <ItemGroup>
      <_AppxExpectedXbf Include="@(Page->'$(OutDir)AppX\%(RelativeDir)%(Filename).xbf')" Condition="'%(Page.Extension)' == '.xaml'" />
    </ItemGroup>
    <Error Condition="!Exists('%(_AppxExpectedXbf.Identity)')" Text="AppX layout at $(OutDir)AppX is missing %(_AppxExpectedXbf.Identity) (stale incremental packaging). Close all Yorii Launcher processes, delete bin/obj/.vs, then Rebuild." />
  </Target>
  <ItemGroup>
    <PRIResource Remove="Yorii-Launcher-preview-0.9\**" />
  </ItemGroup>
  <ItemGroup>
    <PRIResource Remove="AppPackages\**" />
  </ItemGroup>
</Project>
