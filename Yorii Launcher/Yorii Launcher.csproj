  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="%2a%2a\**" />
    <Compile Remove="Authenticator\**" />
    <Compile Remove="Resources\AccentColorThemes\**" />
    <Compile Remove="cmllib.migration\**" />
    <Compile Remove="0.9\**" />
    <Compile Remove="AppPackages\**" />
    <Compile Remove="temp\**" />
    <EmbeddedResource Remove="%2a%2a\**" />
    <EmbeddedResource Remove="Authenticator\**" />
    <EmbeddedResource Remove="Resources\AccentColorThemes\**" />
    <EmbeddedResource Remove="cmllib.migration\**" />
    <EmbeddedResource Remove="0.9\**" />
    <None Remove="%2a%2a\**" />
    <None Remove="Authenticator\**" />
    <None Remove="Resources\AccentColorThemes\**" />
    <None Remove="cmllib.migration\**" />
    <None Remove="0.9\**" />
    <Page Remove="%2a%2a\**" />
    <Page Remove="Authenticator\**" />
    <Page Remove="0.9\**" />
    <Page Remove="Resources\AccentColorThemes\**" />
