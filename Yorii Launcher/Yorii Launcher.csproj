  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="cmllib.migration\Quiescent.Core\Quiescent.Core\Quiescent.Core.csproj" />
    <ProjectReference Include="cmllib.migration\Quiescent.Core\Quiescent.Core.Auth.Microsoft\Quiescent.Core.Auth.Microsoft.csproj" />
    <ProjectReference Include="cmllib.migration\Quiescent.Core\Quiescent.XboxAuthNet.Game\Quiescent.XboxAuthNet.Game.csproj" />
    <!-- net10.0 asset on purpose: the net10.0-windows asset only adds the
         legacy WinForms login broker, which cannot work in trimmed/NativeAOT
         builds (and drags the WebView2 package + Forms into the closure).
         interactive login now uses the WinUI WebView2 surface
         (Helpers/WinUILoginWebUI.cs) instead. -->
    <ProjectReference Include="cmllib.migration\Quiescent.Core\Quiescent.XboxAuthNet\Quiescent.XboxAuthNet.csproj" SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference Include="cmllib.migration\Quiescent.Core\Quiescent.Core.Installer.Forge\Quiescent.Core.Installer.Forge.csproj" />
    <ProjectReference Include="cmllib.migration\Quiescent.Core\Quiescent.Core.Installer.NeoForge\Quiescent.Core.Installer.NeoForge.csproj" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
	  <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
	  <!-- direct ref (same version WinAppSDK pulls transitively): without it the
	       win-x86 native_uap Microsoft.Web.WebView2.Core.dll gets staged into
	       x64 output and every EnsureCoreWebView2Async dies with 0x800700C1.
	       preview 0.9 had this direct ref and was immune -->
	  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
	  <!-- <PackageReference Include="Optifine.Installer" Version="1.0.1" /> -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" PrivateAssets="all" />
