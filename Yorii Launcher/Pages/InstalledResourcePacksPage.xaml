<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Yorii_Launcher.Pages.InstalledResourcePacksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Yorii_Launcher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Yorii_Launcher.Models"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid>
        <Border Padding="12">
            <Grid
                AllowDrop="True"
                DragOver="ResourcePack_DragOver"
                Drop="ResourcePack_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="Installed Resource Packs" />

                <Grid
                    Grid.Row="1"
                    MaxWidth="592"
                    Margin="0,8,0,8"
                    HorizontalAlignment="Center"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="ResourcePacksSearchBox"
                        Grid.Column="0"
                        PlaceholderText="Search Installed Resource Packs..."
                        TextChanged="ResourcePacksSearchBox_TextChanged" />

                    <controls:Segmented
                        x:Name="ResourcePacksViewModeSegmented"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        SelectionChanged="ViewModeSegmented_SelectionChanged">
                        <controls:SegmentedItem AutomationProperties.Name="List view" Icon="{ui:FontIcon Glyph=&#xE8FD;}" />
                        <controls:SegmentedItem AutomationProperties.Name="Grid view" Icon="{ui:FontIcon Glyph=&#xE8A9;}" />
                    </controls:Segmented>
                </Grid>

                <TextBlock
                    x:Name="ResourcePacksErrorText"
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Opacity="0.7"
                    Text="Could not open resource pack."
                    Visibility="Collapsed" />

                <ListView
                    x:Name="ResourcePacksList"
                    Grid.Row="2"
                    Margin="0,0,0,4"
                    Padding="24,0,24,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    BorderThickness="0"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ManagedFileItem">
                            <Border
                                MaxWidth="1200"
                                Margin="0,0,0,6"
                                Padding="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OpenFile_Click" Text="Reveal in Explorer" />
                                        <MenuFlyoutItem Click="OpenModrinth_Click" Text="Open Modrinth Page" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Click="DeleteResourcePack_Click"
                                            Foreground="#FF5555"
                                            Text="Delete Resource Pack" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Margin="6,0,0,0"
                                        Orientation="Horizontal"
                                        Spacing="16">
                                        <Grid Width="40" Height="40">
                                            <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                                            <FontIcon
                                                FontSize="24"
                                                Foreground="{ThemeResource AccentColorBrush}"
                                                Glyph="&#xE8B1;"
                                                Visibility="{x:Bind local:InstalledResourcePacksPage.IconVisibility(Icon)}" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}" />
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.7"
                                                Text="{x:Bind Version}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Width="50"
                                        MinWidth="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="ToggleSwitch_Toggled" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
