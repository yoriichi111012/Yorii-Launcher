<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Yorii_Launcher.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Yorii_Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="ModsNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="240"
        PaneDisplayMode="Top"
        SelectionChanged="ModsNavigation_SelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        </NavigationView.Resources>

        <NavigationView.MenuItems>

            <NavigationViewItem Content="Installed Mods" Tag="installedmods">

                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>

            </NavigationViewItem>

            <NavigationViewItem Content="Installed Resource Packs" Tag="installedrspacks">

                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>

            </NavigationViewItem>

            <!--<NavigationViewItem Content="Installed Modpacks" Tag="installedmodpacks">

                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>

            </NavigationViewItem>-->

            <NavigationViewItem Content="Download Mods" Tag="downloadmods">

                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Download" />
                </NavigationViewItem.Icon>

            </NavigationViewItem>

            <!--<NavigationViewItem Content="Download Modpacks" Tag="downloadmodpacks">

                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Download" />
                </NavigationViewItem.Icon>

            </NavigationViewItem>-->

            <NavigationViewItem Content="Download Resource Packs" Tag="downloadrspacks">

                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Download" />
                </NavigationViewItem.Icon>

            </NavigationViewItem>

        </NavigationView.MenuItems>

        <Frame x:Name="ModsFrame" />

    </NavigationView>

</Page>
