<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Yorii_Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Yorii_Launcher.Helpers"
    xmlns:local="using:Yorii_Launcher">
    <Application.Resources>
        <ResourceDictionary>
            <!--
    accent ramp. the accentcolor* brushes are the app's own semantic keys referenced
    from xaml and are mutated in place at runtime by accentthememanager. the
    systemaccentcolor* color resources that winui's control templates derive from are
    injected at runtime too (declaring them in xaml is not required). the values here
    only matter before the first apply
-->
            <SolidColorBrush x:Key="AccentColorBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="AccentColorLight1Brush" Color="#6FB7FF" />
            <SolidColorBrush x:Key="AccentColorLight2Brush" Color="#94CDFF" />
            <SolidColorBrush x:Key="AccentColorLight3Brush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentColorDark1Brush" Color="#004077" />
            <SolidColorBrush x:Key="AccentColorDark2Brush" Color="#002A50" />
            <SolidColorBrush x:Key="AccentColorDark3Brush" Color="#001428" />
            <SolidColorBrush x:Key="AccentTextColorBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0067C0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0067C0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#004077" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6FB7FF" />

            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#00FFFFFF" />


            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />



            <AcrylicBrush
                x:Key="CustomAcrylicBrush"
                FallbackColor="#B3000000"
                TintColor="#FF000000"
                TintOpacity="0.1" />

            <!--
    light mode variant of the dialog acrylic. the dark brush reads
    wrong on a light page: the sampled backdrop turns the surface
    washed-out white while the fallback band behind the buttons
    stays dark gray
-->
            <AcrylicBrush
                x:Key="CustomAcrylicBrushLight"
                FallbackColor="#B3EDEDED"
                TintColor="#FFF0F0F0"
                TintOpacity="0.3" />

            <!--
    theme-aware acrylic for flyout presenters. desktopacrylicbackdrop
    can't be used here because its light-mode material is designed to
    be nearly opaque white, so the flyouts lose all blur/depth
-->

            <!--
    background overlay acrylic, declared in xaml rather than created in code-behind
    a programmatically-constructed acrylicbrush is a known winui 3 source of
    access-violation crashes (0xc0000005) when the app tears down the visual tree /
    compositor on close, and this overlay only exists once a background+blur setting
    is active (which is exactly when the close crash occurred)
-->
            <AcrylicBrush
                x:Key="OverlayAcrylicDark"
                FallbackColor="#B3000000"
                TintColor="#FF000000"
                TintOpacity="0.6" />
            <AcrylicBrush
                x:Key="OverlayAcrylicLight"
                FallbackColor="#B3FFFFFF"
                TintColor="#FFFFFFFF"
                TintOpacity="0.6" />

            <ItemsPanelTemplate x:Key="PluginListItemsPanel">
                <ItemsStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>

            <ItemsPanelTemplate x:Key="PluginGridItemsPanel">
                <ItemsWrapGrid HorizontalAlignment="Center" Orientation="Horizontal" />
            </ItemsPanelTemplate>

            <Style x:Key="PluginListViewItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="PluginGridViewItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="Width" Value="400" />
                <Setter Property="MinWidth" Value="320" />
                <Setter Property="MaxWidth" Value="480" />
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="Padding" Value="4,0,0,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Resources/ComboBox.xaml" />
                <ResourceDictionary Source="Resources/ThemeOverrides.xaml" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <AcrylicBrush
                                x:Key="PopupAcrylicBrush"
                                FallbackColor="#B3000000"
                                TintColor="#FF000000"
                                TintOpacity="0.1" />
                            <AcrylicBrush
                                x:Key="ContentDialogBackground"
                                FallbackColor="#B3000000"
                                TintColor="#FF000000"
                                TintOpacity="0.1" />
                            <!--
    the template paints the content area with this
    on top of backgroundelement, so make it the same
    acrylic as the dialog background for uniformity
-->
                            <AcrylicBrush
                                x:Key="ContentDialogTopOverlay"
                                FallbackColor="#B3000000"
                                TintColor="#FF000000"
                                TintOpacity="0.1" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <AcrylicBrush
                                x:Key="PopupAcrylicBrush"
                                FallbackColor="#B3EDEDED"
                                TintColor="#FFF0F0F0"
                                TintOpacity="0.3" />
                            <AcrylicBrush
                                x:Key="ContentDialogBackground"
                                FallbackColor="#B3EDEDED"
                                TintColor="#FFF0F0F0"
                                TintOpacity="0.3" />
                            <AcrylicBrush
                                x:Key="ContentDialogTopOverlay"
                                FallbackColor="#B3EDEDED"
                                TintColor="#FFF0F0F0"
                                TintOpacity="0.3" />
                            <!--
    smokelayerbackground is the rectangle behind the
    dialog - its light default washes the page white
    before the dialog's acrylic samples it
-->
                            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#30FFFFFF" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
