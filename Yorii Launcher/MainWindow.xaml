<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Yorii_Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Yorii_Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Yorii Launcher"
    Closed="Window_Closed"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="titleBarRow" Height="auto" />
            <RowDefinition x:Name="contentRow" Height="*" />
        </Grid.RowDefinitions>

        <Image
            x:Name="backgroundImage"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stretch="UniformToFill"
            Visibility="Collapsed" />
        <Grid
            x:Name="overlayGrid"
            Grid.RowSpan="2"
            Opacity="0" />

        <TitleBar
            x:Name="titleBar"
            Title="Yorii Launcher"
            Grid.Row="0"
            VerticalAlignment="Top"
            BackRequested="titleBar_BackRequested"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="False"
            Subtitle="Preview">

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Tiles/GalleryIcon.ico" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <Grid>
                    <!--<AutoSuggestBox
                        x:Name="searchBox"
                        Width="360"
                        VerticalAlignment="Center"
                        PlaceholderText="Search.."
                        QueryIcon="Find" />-->
                    <Grid
                        x:Name="compactTitleBarControls"
                        HorizontalAlignment="Center"
                        ColumnSpacing="8"
                        RowSpacing="2"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="188" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="compactAccountComboBox"
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="220"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            PlaceholderText="Player"
                            SelectionChanged="AccountComboBox_SelectionChanged"
                            Style="{StaticResource AcrylicComboBoxStyle}" />
                        <Button
                            x:Name="compactPlayButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="188"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="PlayButton_Click"
                            Content="Play"
                            Style="{ThemeResource AccentButtonStyle}" />

                        <ComboBox
                            x:Name="compactVersionComboBox"
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="220"
                            Height="32"
                            VerticalAlignment="Center"
                            DropDownClosed="VersionList_DropDownClosed"
                            PlaceholderText="Version"
                            SelectionChanged="VersionList_SelectionChanged"
                            Style="{StaticResource AcrylicComboBoxStyle}" />
                        <ProgressBar
                            x:Name="compactDownloadProgressBar"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Opacity="0"
                            Value="0" />
                    </Grid>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Grid>
                    <StackPanel
                        x:Name="normalTitleBarButtons"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Name="BugReportButton"
                            Width="32"
                            Height="32"
                            Padding="0,0,0,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="BugReportButton_Click"
                            ToolTipService.ToolTip="Report Bug">
                            <FontIcon
                                FontSize="16"
                                FontWeight="Light"
                                Glyph="&#xEBE8;" />
                        </Button>
                        <Button
                            x:Name="CompactModeButton"
                            Width="32"
                            Height="32"
                            Padding="0,0,0,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="CompactModeButton_Click"
                            ToolTipService.ToolTip="Compact Mode">
                            <FontIcon
                                FontSize="16"
                                FontWeight="Light"
                                Glyph="&#xE8A7;" />
                        </Button>
                    </StackPanel>
                    <StackPanel
                        x:Name="compactRightHeaderControls"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <Button
                            x:Name="RestoreOriginalModeButton"
                            Width="32"
                            Height="32"
                            Padding="0,0,0,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="RestoreOriginalModeButton_Click"
                            ToolTipService.ToolTip="Restore Original Mode">
                            <FontIcon
                                FontSize="16"
                                FontWeight="Light"
                                Glyph="&#xE740;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </TitleBar.RightHeader>
        </TitleBar>

        <Frame x:Name="mainFrame" Grid.Row="1" />

    </Grid>
</Window>
