<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Yorii_Launcher.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Yorii_Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Yorii_Launcher.Models"
    mc:Ignorable="d">

    <Grid
        x:Name="contentGrid"
        MaxWidth="1400"
        Padding="32,20,32,0"
        HorizontalAlignment="Stretch"
        ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="398" />
        </Grid.ColumnDefinitions>

        <Grid MaxWidth="1200" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="Release Notes" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Opacity="0.72"
                        Text="Official Minecraft changelogs for available versions." />
                </StackPanel>

                <ComboBox
                    x:Name="releaseNotesVersionComboBox"
                    Grid.Column="1"
                    Height="36"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="ReleaseNotesVersionComboBox_SelectionChanged"
                    Style="{StaticResource AcrylicComboBoxStyle}" />
            </Grid>

            <Grid Grid.Row="1">
                <ProgressRing
                    x:Name="releaseNotesProgressRing"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="True" />

                <TextBlock
                    x:Name="releaseNotesErrorText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Opacity="0.7"
                    Text="Release notes are unavailable right now."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <ScrollViewer
                    x:Name="releaseNotesScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <ContentControl x:Name="releaseNotesContentControl" Padding="0,12,20,12" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid
            x:Name="rightColumn"
            Grid.Column="1"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="instancesRow" Height="*" />
                <RowDefinition x:Name="serverRow" Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="instancesPanel"
                Grid.Row="0"
                Margin="0,0,0,14"
                RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Instances" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Opacity="0.72"
                            Text="Choose a Minecraft instance to play or create a new one."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Height="36"
                        Click="CreateInstance_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Create" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock
                        x:Name="emptyInstancesText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Opacity="0.7"
                        Text="No instances yet. Create one to start with a clean Minecraft folder."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <GridView
                        x:Name="instancesGrid"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsItemClickEnabled="True"
                        ItemClick="InstancesGrid_ItemClick"
                        SelectionMode="Single">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:LauncherInstance">
                                <Grid Width="180" Height="140">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Border
                                                    Width="62"
                                                    Height="62"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="8">
                                                    <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                                                </Border>

                                                <Button
                                                    Width="30"
                                                    Height="30"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Click="OpenInstanceFolder_Click"
                                                    ToolTipService.ToolTip="Open folder">
                                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                                </Button>

                                                <Button
                                                    Width="30"
                                                    Height="30"
                                                    Margin="0,36,0,0"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Click="DeleteInstance_Click"
                                                    ToolTipService.ToolTip="Delete instance">
                                                    <FontIcon
                                                        FontSize="16"
                                                        Foreground="#FF7878"
                                                        Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Opacity="0.65"
                                                    Text="{x:Bind Id}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Grid>

            <Grid
                x:Name="serverListPanel"
                Grid.Row="1"
                RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="Servers" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Opacity="0.72"
                        Text="Select a server to auto-connect when launching."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <TextBlock
                        x:Name="emptyServersText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Opacity="0.7"
                        Text="No servers found. Add servers in Minecraft first."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <ListView
                        x:Name="serversListView"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        SelectionChanged="ServersListView_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ServerItem">
                                <Grid Padding="12,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center">
                                        <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                                        <FontIcon
                                            FontSize="20"
                                            Foreground="{ThemeResource SystemAccentColor}"
                                            Glyph="&#xE7F4;"
                                            Visibility="{x:Bind local:HomePage.IconVisibility(Icon)}" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.65"
                                            Text="{x:Bind Address}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
